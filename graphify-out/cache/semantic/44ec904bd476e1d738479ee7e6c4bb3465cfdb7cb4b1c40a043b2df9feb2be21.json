{"nodes": [{"id": "docs_verificacion_sesion_1_guide", "label": "Verificaci\u00f3n \u2014 Sesi\u00f3n 1 (Landing viva)", "file_type": "document", "source_file": "docs/verificacion-sesion-1.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_verificacion_sesion_1_reduced_motion", "label": "Movimiento reducido (versi\u00f3n est\u00e1tica v\u00eda matchMedia)", "file_type": "concept", "source_file": "docs/verificacion-sesion-1.md", "source_location": "L177", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No hay rama reducida: con prefers-reduced-motion matchMedia no crea nada; la p\u00e1gina es el marcado de la Fase 4 tal cual (0 triggers, 0 pin-spacer)."}, {"id": "docs_verificacion_sesion_1_section_states", "label": "Estado esperado por secci\u00f3n (escritorio/celular/est\u00e1tico)", "file_type": "concept", "source_file": "docs/verificacion-sesion-1.md", "source_location": "L20", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_verificacion_sesion_1_hero", "label": "Hero (pupila, sello, trazos, parallax)", "file_type": "concept", "source_file": "docs/verificacion-sesion-1.md", "source_location": "L26", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_verificacion_sesion_1_reveal", "label": "Revelaci\u00f3n (pin 1200 px, pupila marino, entra Opti)", "file_type": "concept", "source_file": "docs/verificacion-sesion-1.md", "source_location": "L27", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_verificacion_sesion_1_how_it_works", "label": "C\u00f3mo funciona (pin 1500 px, tres pasos, tel\u00e9fono)", "file_type": "concept", "source_file": "docs/verificacion-sesion-1.md", "source_location": "L28", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_verificacion_sesion_1_compact_mode", "labe