{"nodes": [{"id": "docs_verificacion_sesion_2_verificacion", "label": "Verificaci\u00f3n Sesi\u00f3n 2 \u2014 Consulta con Opti (scripted engine)", "file_type": "document", "source_file": "docs/verificacion-sesion-2.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_verificacion_sesion_2_route_matrix", "label": "Matriz de recorridos (consultation test paths)", "file_type": "concept", "source_file": "docs/verificacion-sesion-2.md", "source_location": "L22", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_verificacion_sesion_2_contract", "label": "Consultation contract (types.ts + schema.ts, zod)", "file_type": "rationale", "source_file": "docs/verificacion-sesion-2.md", "source_location": "L55", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "UI only trusts turns that pass parseAssistantTurn; no React/DOM dependency so the Session 3 server validates Claude output with the same schema."}, {"id": "docs_verificacion_sesion_2_catalog_resolution", "label": "Cards built from local catalog by productId (resolveRecommendations)", "file_type": "rationale", "source_file": "docs/verificacion-sesion-2.md", "source_location": "L67", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only the reason comes from the turn; name, price, photo, tags and link come from the catalog, so provider text can never inject product data."}, {"id": "docs_verificacion_sesion_2_stale_response_guard", "label": "requestId guard against stale/duplicate responses", "file_type": "rationale", "source_file": "docs/verificacion-sesion-2.md", "source_location": "L91", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reducer accepts a response only if its id is current and phase is waiting; protects against restarts and StrictMode double-mount."}, {"id": "docs_verificacion_sesion_2_fixed_height_chat", "label": "Fixed-height chat card (720/784 px) to keep ScrollTrigger pins stable", "file_type": "rationale", "source_file": "docs/verificacion-sesion-2.md", "source_location": "L119", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ScrollTriggers below the consultation depend on page height; if the chat grew they would all misalign. History scrolls via own scrollTop, never scrollIntoView."}, {"id": "docs_verificacion_sesion_2_focus_management", "label": "Focus management in consultation (never on body)", "file_type": "concept", "source_file": "docs/verificacion-sesion-2.md", "source_location": "L167", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_verificacion_sesion_2_hash_anchor_scroll", "label": "Hash anchor scroll in App.tsx after ScrollTrigger refresh", "file_type": "concept", "source_file": "docs/verificacion-sesion-2.md", "source_location": "L183", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_verificacion_sesion_2_no_storage", "label": "Nothing is stored (no localStorage/sessionStorage/cookies)", "file_type": "rationale", "source_file": "docs/verificacion-sesion-2.md", "source_location": "L196", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Conversations are health data; storing them would require privacy notice and consent."}, {"id": "docs_verificacion_sesion_2_astigmatism_rule", "label": "recommend() never suggests spherical lens with astigmatism", "file_type": "concept", "source_file": "docs/verificacion-sesion-2.md", "source_location": "L212", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_verificacion_sesion_2_contract", "target": "consulta_types_assistantturn", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/verificacion-sesion-2.md",