# Copia este archivo como .env.local (ya está en .gitignore) y llena los valores.
# En Vercel, las mismas variables van en Project Settings → Environment Variables.

# Solo servidor. Nunca con prefijo VITE_: ese prefijo la metería al bundle del navegador.
ANTHROPIC_API_KEY=
# Opcional. Por defecto claude-haiku-5-5.
ANTHROPIC_MODEL=

# Cliente. api (por defecto) | scripted
VITE_CONSULTA_PROVIDER=
# Cliente. Vacío = mismo origen (/api/chat). Si el backend se muda, su URL base.
VITE_API_BASE_URL=
